#!/usr/bin/env python3
"""codex notify hook: harness-side completion sentinel for zdel workers.

Invoked by codex as: zdel-notify <worker-dir> <json-payload>.
Touches the current turn's .done file so zdel wait never depends on the
worker model writing files; falls back to last-assistant-message for the
result file when the model skipped it.
"""
import json
import os
import sys

def main() -> None:
    if len(sys.argv) < 3:
        return
    worker_dir = sys.argv[1]
    try:
        payload = json.loads(sys.argv[2])
    except ValueError:
        return
    if payload.get("type") != "agent-turn-complete":
        return
    try:
        with open(os.path.join(worker_dir, "turn")) as f:
            turn = f.read().split()[0]
    except (OSError, IndexError):
        return  # worker already stopped
    result_file = os.path.join(worker_dir, f"turn-{turn}.md")
    message = payload.get("last-assistant-message") or ""
    if message and not os.path.exists(result_file):
        with open(result_file, "w") as f:
            f.write(message + "\n")
    with open(os.path.join(worker_dir, f"turn-{turn}.done"), "a"):
        pass

if __name__ == "__main__":
    main()
