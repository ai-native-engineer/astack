#!/usr/bin/env python3
"""Codex notify / Claude Stop hook for zdel workers.

Codex passes JSON as argv[2]; Claude passes JSON on stdin. The hook stores the
final assistant message and touches the current turn's .done file.
"""
import json
import os
import sys

def main() -> None:
    if len(sys.argv) < 2:
        return
    worker_dir = sys.argv[1]
    try:
        payload = json.loads(sys.argv[2] if len(sys.argv) > 2 else sys.stdin.read())
    except ValueError:
        return
    if payload.get("type") == "agent-turn-complete":
        message = payload.get("last-assistant-message") or ""
    elif payload.get("hook_event_name") == "Stop":
        message = payload.get("last_assistant_message") or ""
    else:
        return
    try:
        with open(os.path.join(worker_dir, "turn")) as f:
            turn = f.read().split()[0]
    except (OSError, IndexError):
        return  # worker already stopped
    result_file = os.path.join(worker_dir, f"turn-{turn}.md")
    if message and not os.path.exists(result_file):
        with open(result_file, "w") as f:
            f.write(message + "\n")
    with open(os.path.join(worker_dir, f"turn-{turn}.done"), "a"):
        pass

if __name__ == "__main__":
    main()
