#!/usr/bin/env python3
"""claude Stop hook: harness-side completion sentinel for zdel workers.

Registered via `claude --settings` as: zdel-notify-claude <worker-dir>.
Reads the hook payload from stdin, touches the current turn's .done file,
and falls back to the transcript's last assistant message for the result
file when the worker model skipped writing it.
"""
import json
import os
import sys
import time

def last_assistant_text(transcript_path: str) -> str:
    text = ""
    try:
        with open(transcript_path) as f:
            for line in f:
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                if entry.get("type") != "assistant":
                    continue
                blocks = entry.get("message", {}).get("content", [])
                parts = [b.get("text", "") for b in blocks if isinstance(b, dict) and b.get("type") == "text"]
                if parts:
                    text = "\n".join(parts)
    except OSError:
        pass
    return text

def main() -> None:
    if len(sys.argv) < 2:
        return
    worker_dir = sys.argv[1]
    try:
        payload = json.loads(sys.stdin.read())
    except ValueError:
        return
    if payload.get("hook_event_name", "Stop") != "Stop":
        return
    try:
        with open(os.path.join(worker_dir, "turn")) as f:
            turn = f.read().split()[0]
    except (OSError, IndexError):
        return  # worker already stopped
    result_file = os.path.join(worker_dir, f"turn-{turn}.md")
    if not os.path.exists(result_file):
        # the Stop hook can fire before the final assistant entry is
        # flushed to the transcript, so retry briefly
        message = ""
        for _ in range(4):
            message = last_assistant_text(payload.get("transcript_path", ""))
            if message:
                break
            time.sleep(0.5)
        if message:
            with open(result_file, "w") as f:
                f.write(message + "\n")
    with open(os.path.join(worker_dir, f"turn-{turn}.done"), "a"):
        pass

if __name__ == "__main__":
    main()
